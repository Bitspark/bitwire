{
  "name": "a frame over the receiving client peer's limit ends the connection with 1009",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "description": "Authored by bitwire from SCOPE.md, \"The connection beneath\": \"A frame larger than the receiver's limit is refused before delivery. The receiver ends the connection with 1009.\" A frame of exactly the limit is served first, so the limit is the one configured; the over-limit request never reaches its handler. What the sender observes is the transport's, so its send may succeed or find the connection ended. The receiving peer holds the client role.",
  "needs": [
    "peer",
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peer_and_conn",
      "args": {
        "peer": "a",
        "role": "client",
        "options": {
          "max_frame_bytes": 1024
        }
      },
      "bind": {
        "peer": "pa",
        "conn": "cb"
      }
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$pa",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:1\",\"method\":\"4:echo\",\"params\":\"\"}"
      },
      "note": "a request of exactly 1024 bytes"
    },
    {
      "on": "a",
      "op": "peer.await_request",
      "args": {
        "on": "$pa",
        "method": "echo",
        "phase": "started"
      },
      "expect": {
        "phase": "started"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$cb"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:\"id\"\\s*:\\s*\"s:1\""
      },
      "note": "a frame of exactly the limit is served"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"s:2\",\"method\":\"4:echo\",\"params\":\"\"}"
      },
      "expect": {},
      "expect_error": {
        "code": "$regex:^(closed|failed)$"
      },
      "note": "a well-formed request of 1025 bytes; the sender's own observation is the transport's"
    },
    {
      "on": "a",
      "op": "peer.await_close",
      "args": {
        "on": "$pa"
      },
      "expect": {
        "code": 1009,
        "clean": false
      },
      "note": "the receiving peer ends the connection with 1009"
    },
    {
      "on": "a",
      "op": "peer.await_request",
      "args": {
        "on": "$pa",
        "method": "echo",
        "phase": "started",
        "within_ms": 200
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "refused before delivery: the over-limit request never reached its handler"
    }
  ]
}
