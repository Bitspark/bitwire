{
  "name": "a handler that gives up is an internal error to the caller, a panic to the observer, and the connection serves on",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "optional": "observer",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/peer/handler-panic.json",
    "sha256": "d2fa7befcf938aa142a893e279bba3141df025711e034fbf2ecb6943f4edb4b4"
  },
  "needs": [
    "observer",
    "peer"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a",
        "server_options": {
          "observe": true
        }
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$pa",
        "method": "give-up",
        "behavior": {
          "kind": "panic",
          "value": "the handler gave up"
        }
      }
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$pa",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$pb",
        "method": "give-up",
        "params": {}
      },
      "bind": "c"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c"
      },
      "expect": {
        "error": {
          "code": "internal"
        }
      }
    },
    {
      "on": "a",
      "op": "peer.await_request",
      "args": {
        "on": "$pa",
        "method": "give-up",
        "phase": "ended"
      },
      "expect": {
        "outcome": "panic"
      }
    },
    {
      "on": "a",
      "op": "peer.observed",
      "args": {
        "on": "$pa"
      },
      "expect": {
        "$contains": [
          {
            "type": "handler.panic",
            "method": "give-up",
            "value": "$regex:the handler gave up"
          },
          {
            "type": "request.ended",
            "method": "give-up",
            "outcome": "error"
          }
        ]
      }
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$pb",
        "method": "echo",
        "params": "still"
      },
      "bind": "c2"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c2"
      },
      "expect": {
        "result": "still"
      }
    }
  ]
}
