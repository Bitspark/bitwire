{
  "name": "a well-formed frame of every kind is taken without ending the connection",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/peer/well-formed-frame-is-served.json",
    "sha256": "d9c51c1039c0207ce54c7ffc8dd1acb89545852a4b8bfee795f048c52285e30f"
  },
  "needs": [
    "peer",
    "seam"
  ],
  "foreach": {
    "table": "tables/frames.json",
    "as": "row",
    "where": {
      "valid": true
    }
  },
  "steps": [
    {
      "on": "runner",
      "op": "pair.peer_and_conn",
      "args": {
        "peer": "b",
        "role": "server"
      },
      "bind": {
        "peer": "pb",
        "conn": "ca"
      }
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$pb",
        "method": "read",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "$row.frame"
      }
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb",
        "within_ms": 300
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "the peer is still there"
    },
    {
      "on": "a",
      "op": "conn.close",
      "args": {
        "on": "$ca",
        "code": 1000,
        "reason": "done"
      }
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb"
      },
      "expect": {
        "clean": true
      },
      "note": "and ends cleanly when the raw side chooses to, so the frame did the connection no harm"
    }
  ]
}
