{
  "name": "a binary frame ends the connection without dispatching its JSON request, with canonical names",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "description": "Authored by bitwire. It keeps every step of the defective derivative peer/binary-frame-ends-the-connection, whose raw frames name the plain method \"echo\": serving a plain name needs a plain-name handler, which revision 1 does not require (SCOPE.md, Paths). Here the raw frames name the driver's handler canonically, \"4:echo\" (CONTRACT.md §4.3, Names).",
  "needs": [
    "peer",
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peer_and_conn",
      "args": {
        "peer": "b",
        "role": "server"
      },
      "bind": {
        "peer": "pb",
        "conn": "ca"
      }
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$pb",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"4:echo\",\"params\":\"text\"}"
      }
    },
    {
      "on": "b",
      "op": "peer.await_request",
      "args": {
        "on": "$pb",
        "method": "echo",
        "phase": "started"
      },
      "expect": {
        "phase": "started"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": "$regex:\"result\"\\s*:\\s*\"text\""
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "binary",
        "base64": "eyJ2ZXJzaW9uIjoxLCJraW5kIjoicmVxdWVzdCIsImlkIjoiYzoyIiwibWV0aG9kIjoiNDplY2hvIiwicGFyYW1zIjoiYmluYXJ5In0="
      },
      "note": "The bytes are {\"version\":1,\"kind\":\"request\",\"id\":\"c:2\",\"method\":\"4:echo\",\"params\":\"binary\"}: a valid request, carried by the wrong frame kind."
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb"
      },
      "expect": {
        "clean": false,
        "code": 4011
      }
    },
    {
      "on": "a",
      "op": "conn.await_close",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "code": 4011
      },
      "note": "The raw side receives the profile refusal code, rather than an abort or the seam's unsupported-data code."
    },
    {
      "on": "b",
      "op": "peer.await_request",
      "args": {
        "on": "$pb",
        "method": "echo",
        "phase": "started",
        "within_ms": 200
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "Closure is the barrier: the refused frame has been consumed, and no second request reached the handler."
    }
  ]
}
