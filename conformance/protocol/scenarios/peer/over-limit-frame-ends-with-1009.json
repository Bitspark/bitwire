{
  "name": "a frame over the receiving peer's limit ends the connection with 1009",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "description": "Authored by bitwire from SCOPE.md, \"The connection beneath\": \"A frame larger than the receiver's limit is refused before delivery. The receiver ends the connection with 1009.\" What the sender observes is the transport's, so only the receiver is held.",
  "needs": [
    "peer",
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peer_and_conn",
      "args": {
        "peer": "a",
        "role": "server",
        "options": {
          "max_frame_bytes": 1024
        }
      },
      "bind": {
        "peer": "pa",
        "conn": "cb"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"pad\",\"data\":\"\"}"
      },
      "note": "a well-formed event of 1025 bytes, one over the peer's limit"
    },
    {
      "on": "a",
      "op": "peer.await_close",
      "args": {
        "on": "$pa"
      },
      "expect": {
        "code": 1009,
        "clean": false
      },
      "note": "the receiving peer ends the connection with 1009"
    }
  ]
}
