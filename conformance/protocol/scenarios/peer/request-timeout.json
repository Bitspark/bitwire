{
  "name": "a call whose deadline passes ends with request_timeout, and the connection serves on",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/peer/request-timeout.json",
    "sha256": "78083d5818200afa614b9e96559533492c131da61c95d0338eb86f735c00952e"
  },
  "needs": [
    "peer"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a",
        "client_options": {
          "request_timeout_ms": 300
        }
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$pa",
        "method": "wait",
        "behavior": {
          "kind": "wait"
        }
      }
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$pa",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$pb",
        "method": "wait",
        "params": {}
      },
      "bind": "c"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c",
        "within_ms": 3000
      },
      "expect": {
        "error": {
          "code": "request_timeout"
        }
      }
    },
    {
      "on": "a",
      "op": "peer.await_request",
      "args": {
        "on": "$pa",
        "method": "wait",
        "phase": "ended"
      },
      "expect": {
        "outcome": "cancelled"
      },
      "note": "the caller's deadline cancels the handler too"
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$pb",
        "method": "echo",
        "params": 1
      },
      "bind": "c2"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c2"
      },
      "expect": {
        "result": 1
      }
    }
  ]
}
