{
  "name": "an event reaches the other side in either direction, with its data",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/peer/events-both-ways.json",
    "sha256": "2073c3b0505dce71c07ab1926ae32e56ae23699257ac72668de40841e35b1bff"
  },
  "replaces": "runtime/go/interop_test.go: notify and client_notice",
  "needs": [
    "peer"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "peer.emit",
      "args": {
        "on": "$pa",
        "event": "notice",
        "data": {
          "value": 42
        }
      }
    },
    {
      "on": "b",
      "op": "peer.await_event",
      "args": {
        "on": "$pb",
        "name": "notice"
      },
      "expect": {
        "data": {
          "value": 42
        }
      }
    },
    {
      "on": "b",
      "op": "peer.emit",
      "args": {
        "on": "$pb",
        "event": "client_notice",
        "data": {
          "value": 99
        }
      }
    },
    {
      "on": "a",
      "op": "peer.await_event",
      "args": {
        "on": "$pa",
        "name": "client_notice"
      },
      "expect": {
        "data": {
          "value": 99
        }
      }
    },
    {
      "on": "a",
      "op": "peer.emit",
      "args": {
        "on": "$pa",
        "event": "empty"
      }
    },
    {
      "on": "b",
      "op": "peer.await_event",
      "args": {
        "on": "$pb",
        "name": "empty"
      },
      "expect": {
        "data": null
      },
      "note": "an event without data carries null"
    },
    {
      "on": "b",
      "op": "peer.await_event",
      "args": {
        "on": "$pb",
        "name": "never",
        "within_ms": 200
      },
      "expect_error": {
        "code": "timeout"
      }
    }
  ]
}
