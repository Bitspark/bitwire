{
  "name": "a request serial that increases is served, gaps and all",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/peer/request-serials-may-leave-gaps.json",
    "sha256": "400ef58d8f0786b5b7c5cfb8b3df25f0dbf128a920bb4d832c50030aaafe3d9f"
  },
  "needs": [
    "peer",
    "seam"
  ],
  "foreach": {
    "table": "tables/serials.json",
    "as": "row",
    "where": {
      "valid": true
    }
  },
  "steps": [
    {
      "on": "runner",
      "op": "pair.peer_and_conn",
      "args": {
        "peer": "b",
        "role": "server"
      },
      "bind": {
        "peer": "pb",
        "conn": "ca"
      }
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$pb",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "$row.before"
      },
      "note": "what the direction published first"
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "$row.frame"
      },
      "note": "and a serial the receiver admits"
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb",
        "within_ms": 300
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "the peer is still there"
    },
    {
      "on": "a",
      "op": "conn.close",
      "args": {
        "on": "$ca",
        "code": 1000,
        "reason": "done"
      }
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb"
      },
      "expect": {
        "clean": true
      },
      "note": "and ends cleanly when the raw side chooses to, so the frame did the connection no harm"
    }
  ]
}
