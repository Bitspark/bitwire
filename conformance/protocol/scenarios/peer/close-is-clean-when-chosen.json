{
  "name": "a peer's close is clean on both sides when a side chose it, and not when the transport failed",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/peer/close-is-clean-when-chosen.json",
    "sha256": "e6a69dee0b133f9dbece9caed9c31b86e6a431ed2271751e06bf0def3de61aa9"
  },
  "needs": [
    "peer",
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "b",
      "op": "peer.close",
      "args": {
        "on": "$pb"
      }
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb"
      },
      "expect": {
        "clean": true
      }
    },
    {
      "on": "a",
      "op": "peer.await_close",
      "args": {
        "on": "$pa"
      },
      "expect": {
        "clean": "$bool"
      },
      "note": "how a chosen close reaches the remote is the transport's: a clean close frame, or an abort"
    },
    {
      "on": "runner",
      "op": "pair.peer_and_conn",
      "args": {
        "peer": "a",
        "role": "server"
      },
      "bind": {
        "peer": "pa2",
        "conn": "cb"
      }
    },
    {
      "on": "b",
      "op": "conn.abort",
      "args": {
        "on": "$cb"
      }
    },
    {
      "on": "a",
      "op": "peer.await_close",
      "args": {
        "on": "$pa2"
      },
      "expect": {
        "clean": false
      },
      "note": "a transport that broke is not a close anyone chose"
    }
  ]
}
