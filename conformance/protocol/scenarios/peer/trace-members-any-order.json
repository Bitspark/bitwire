{
  "name": "a response carries its request's trace members byte for byte, in any member order",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "description": "Authored by bitwire from profile.md \"Trace context\", which SCOPE.md binds: \"a response carries its request's members byte for byte\", and \"a tracestate that arrived without a traceparent continues no trace and is carried back on the response\". It replaces the defective derivative peer/trace-members-verbatim, whose pattern assumed an order of envelope members. The response is asserted structurally ($json, CONTRACT.md §6.8): its kind, id and trace members at the envelope's top level. The tracestate keeps the optional whitespace W3C allows, so a peer that re-serializes it fails.",
  "needs": [
    "peer",
    "propagator",
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peer_and_conn",
      "args": {
        "peer": "b",
        "role": "server",
        "options": {
          "propagate": true
        }
      },
      "bind": {
        "peer": "pb",
        "conn": "ca"
      }
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$pb",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"4:echo\",\"params\":{},\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\",\"tracestate\":\"congo=t61rcWkgMzE, rojo=00f067aa0ba902b7\"}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": {
          "$json": {
            "version": 1,
            "kind": "response",
            "id": "c:1",
            "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
            "tracestate": "congo=t61rcWkgMzE, rojo=00f067aa0ba902b7"
          }
        }
      },
      "note": "the response to c:1 carries its traceparent and tracestate as envelope members, byte for byte"
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:2\",\"method\":\"4:echo\",\"params\":{},\"tracestate\":\"congo=t61rcWkgMzE, rojo=00f067aa0ba902b7\"}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": {
          "$json": {
            "version": 1,
            "kind": "response",
            "id": "c:2",
            "tracestate": "congo=t61rcWkgMzE, rojo=00f067aa0ba902b7",
            "traceparent": "$absent"
          }
        }
      },
      "note": "a tracestate that arrived alone continues no trace and is carried back alone"
    }
  ]
}
