{
  "name": "a plain name that nothing handles is answered method_not_found, and the connection lives",
  "layer": "peer",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "description": "Authored by bitwire from SCOPE.md, \"Paths\" (finding F3): \"The envelope does not require the canonical form. [...] Any other name is dispatched by that name. A request that nothing handles is answered method_not_found, and an event that nothing handles is dropped. Revision 1 does not reject plain names.\"",
  "needs": [
    "peer",
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peer_and_conn",
      "args": {
        "peer": "b",
        "role": "server"
      },
      "bind": {
        "peer": "pb",
        "conn": "ca"
      }
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$pb",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:1\",\"method\":\"read\",\"params\":{}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": {
          "$json": {
            "kind": "response",
            "id": "c:1",
            "error": {
              "code": "method_not_found"
            },
            "result": "$absent"
          }
        }
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"event\",\"event\":\"notice\",\"data\":null}"
      },
      "note": "a plain event name nothing handles is dropped"
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "{\"version\":1,\"kind\":\"request\",\"id\":\"c:2\",\"method\":\"4:echo\",\"params\":{}}"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": {
          "$json": {
            "kind": "response",
            "id": "c:2",
            "result": "$any",
            "error": "$absent"
          }
        }
      }
    },
    {
      "on": "b",
      "op": "peer.await_close",
      "args": {
        "on": "$pb",
        "within_ms": 200
      },
      "expect_error": {
        "code": "timeout"
      },
      "note": "no plain name ended the connection"
    }
  ]
}
