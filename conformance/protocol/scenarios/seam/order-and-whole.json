{
  "name": "frames arrive in order and whole, text and binary alike",
  "layer": "seam",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/seam/order-and-whole.json",
    "sha256": "05f23e7e24fc9ed3ff25c294279ea609fa89311c08af729304bd75a3789fe387"
  },
  "replaces": "duplex/go/duplextest, its first scenario",
  "needs": [
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.conns",
      "bind": {
        "a": "ca",
        "b": "cb"
      },
      "args": {
        "limit_a": 1048576,
        "limit_b": 1048576
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "frame 00"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "binary",
        "base64": "ZnJhbWUgMDE="
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "frame 02"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "binary",
        "base64": "AAECAwQFBgcICQ=="
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": "frame 00"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "binary",
        "base64": "ZnJhbWUgMDE="
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": "frame 02"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "binary",
        "base64": "AAECAwQFBgcICQ=="
      }
    },
    {
      "on": "a",
      "op": "conn.send",
      "args": {
        "on": "$ca",
        "kind": "text",
        "text": "back"
      }
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$cb"
      },
      "expect": {
        "kind": "text",
        "text": "back"
      }
    }
  ]
}
