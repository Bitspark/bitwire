{
  "name": "a close carries its code and reason across",
  "layer": "seam",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/seam/close-carries-code-and-reason.json",
    "sha256": "68f0b696e0d5e8d592a52c6648f082e075a5853ff42c1aacdac07740b3cbc367"
  },
  "replaces": "duplex/go/duplextest, its third scenario",
  "needs": [
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.conns",
      "bind": {
        "a": "ca",
        "b": "cb"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "last"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "kind": "text",
        "text": "last"
      }
    },
    {
      "on": "b",
      "op": "conn.close",
      "args": {
        "on": "$cb",
        "code": 1008,
        "reason": "an observer sent a deciding frame"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect_error": {
        "code": "closed",
        "close_code": 1008,
        "reason": "an observer sent a deciding frame"
      }
    },
    {
      "on": "a",
      "op": "conn.await_close",
      "args": {
        "on": "$ca"
      },
      "expect": {
        "code": 1008,
        "reason": "an observer sent a deciding frame"
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "after"
      },
      "expect_error": {
        "code": "closed"
      },
      "note": "a closed connection sends nothing"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$cb",
        "within_ms": 500
      },
      "expect_error": {
        "code": "closed"
      }
    }
  ]
}
