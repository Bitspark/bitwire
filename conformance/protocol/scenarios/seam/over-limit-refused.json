{
  "name": "a frame over the limit is refused, and the connection with it",
  "layer": "seam",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/seam/over-limit-refused.json",
    "sha256": "65e2a47d97878d55575b8dad98dfe5952906da1c8cc14330f43a82b508bdf26b"
  },
  "replaces": "duplex/go/duplextest, its fourth scenario",
  "needs": [
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.conns",
      "bind": {
        "a": "ca",
        "b": "cb"
      },
      "args": {
        "limit_a": 1024,
        "limit_b": 1048576
      }
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": ""
      },
      "note": "1025 bytes to a side whose limit is 1024"
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect_error": {
        "code": "$regex:^(closed|failed)$"
      },
      "note": "the frame is refused and the connection ends: a close the transport sent, or a failure"
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca",
        "within_ms": 500
      },
      "expect_error": {
        "code": "$regex:^(closed|failed)$"
      },
      "note": "and stays ended"
    }
  ]
}
