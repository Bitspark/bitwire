{
  "name": "an abort ends the connection at once on both sides",
  "layer": "seam",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "core",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/seam/abort-ends-both-sides.json",
    "sha256": "cb7735f340d7013aa8ba0089366696073ced6d7c0ccef3d49c97aa33b6b112ad"
  },
  "replaces": "duplex/go/duplextest, its fifth scenario",
  "needs": [
    "seam"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.conns",
      "bind": {
        "a": "ca",
        "b": "cb"
      }
    },
    {
      "on": "b",
      "op": "conn.abort",
      "args": {
        "on": "$cb"
      }
    },
    {
      "on": "a",
      "op": "conn.receive",
      "args": {
        "on": "$ca"
      },
      "expect_error": {
        "code": "$regex:^(closed|failed)$"
      },
      "note": "the remote ends without a close frame: an abnormal close, or a failure"
    },
    {
      "on": "b",
      "op": "conn.receive",
      "args": {
        "on": "$cb",
        "within_ms": 500
      },
      "expect_error": {
        "code": "closed"
      },
      "note": "the local side is closed at once"
    },
    {
      "on": "b",
      "op": "conn.send",
      "args": {
        "on": "$cb",
        "kind": "text",
        "text": "x"
      },
      "expect_error": {
        "code": "closed"
      }
    }
  ]
}
