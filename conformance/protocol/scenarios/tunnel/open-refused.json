{
  "name": "an open the other side has no room for is refused with channel_refused, and the observer sees the refusal",
  "layer": "tunnel",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "tunnel",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/tunnel/open-refused.json",
    "sha256": "e245e0937ed793f51ddeced6e450eea4a1a5ca0fe1681474d66139c48f1ee92e"
  },
  "needs": [
    "peer",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa",
        "options": {
          "accept_capacity": 1
        }
      },
      "bind": "ta"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "tb"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "probe"
      },
      "bind": {
        "handle": "c1"
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "probe"
      },
      "expect_error": {
        "code": "channel_refused"
      },
      "note": "one opened and not yet accepted is all the other side holds"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$ta"
      },
      "expect": {
        "family": "probe"
      },
      "note": "the first stands"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "probe"
      },
      "bind": {
        "handle": "c2"
      },
      "note": "and with room again, an open is taken"
    }
  ]
}
