{
  "name": "channel admission refuses a differing declaration digest, naming the family, before accepting any inner frame",
  "layer": "tunnel",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "tunnel",
  "description": "Authored by bitwire from tunnel.md, which SCOPE.md adopts: \"Two nonempty digests that differ are refused contract_mismatch, naming the family.\" It keeps the steps of the defective derivative tunnel/declaration-digest, which expected Nightseam Go's exact refusal message. It reads the refusal on the wire, through a raw channel.open, and requires only that the family is named in the message or the data. The family \"quokka\" is a word no refusal would contain by accident.",
  "needs": [
    "peer",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa",
        "options": {
          "accept_capacity": 1,
          "contracts": {
            "quokka": "8666a8fbdacb02b4e8c807fc3b01d56d31bf2fef60626d163b896b0c939a84a6"
          }
        }
      },
      "bind": "ta"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "tb"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "quokka",
        "digest": "2652993925b416656e545667c44375ad6e07430586b4416433d0df4534a8303d"
      },
      "expect_error": {
        "code": "contract_mismatch"
      },
      "note": "two differing nonempty digests are refused; the driver fixes only the code of this answer"
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$pb",
        "method": "channel.open",
        "params": {
          "channel": 99,
          "family": "quokka",
          "digest": "2652993925b416656e545667c44375ad6e07430586b4416433d0df4534a8303d",
          "window": 32
        }
      },
      "bind": "raw",
      "note": "the same open, sent as the tunnel vocabulary's own request, so that the refusal is read as the refusing side sent it"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$raw"
      },
      "expect": {
        "error": {
          "code": "contract_mismatch"
        }
      },
      "assert": {
        "present": "quokka"
      },
      "note": "the refusal names the family, in its message or its data"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "quokka",
        "digest": "8666a8fbdacb02b4e8c807fc3b01d56d31bf2fef60626d163b896b0c939a84a6"
      },
      "bind": {
        "handle": "cb",
        "id": "opened"
      }
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$ta"
      },
      "expect": {
        "id": "$opened",
        "family": "quokka",
        "digest": "8666a8fbdacb02b4e8c807fc3b01d56d31bf2fef60626d163b896b0c939a84a6"
      },
      "bind": {
        "handle": "ca"
      },
      "note": "the refused channel occupied no capacity and never reached an acceptor"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$ca",
        "role": "server"
      },
      "bind": "innera"
    },
    {
      "on": "b",
      "op": "peer.over",
      "args": {
        "on": "$cb",
        "role": "client"
      },
      "bind": "innerb"
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$innera",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$innerb",
        "method": "echo",
        "params": {
          "text": "both revisions accept this value"
        }
      },
      "bind": "call"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$call"
      },
      "expect": {
        "result": {
          "text": "both revisions accept this value"
        }
      }
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "quokka"
      },
      "bind": {
        "handle": "untyped"
      }
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$ta"
      },
      "expect": {
        "family": "quokka",
        "digest": ""
      },
      "note": "absence is not a revision mismatch"
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$ta",
        "family": "quokka",
        "digest": "8666a8fbdacb02b4e8c807fc3b01d56d31bf2fef60626d163b896b0c939a84a6"
      }
    },
    {
      "on": "b",
      "op": "tunnel.accept",
      "args": {
        "on": "$tb"
      },
      "expect": {
        "family": "quokka",
        "digest": "8666a8fbdacb02b4e8c807fc3b01d56d31bf2fef60626d163b896b0c939a84a6"
      },
      "note": "a receiver carrying no expected digest also accepts"
    }
  ]
}
