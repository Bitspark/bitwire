{
  "name": "a channel opened from either side is accepted with its family, carries a peer, and its id says who opened it",
  "layer": "tunnel",
  "protocol": {
    "revision": "bitwire/1",
    "normativeDigest": "7797682b0f05f86c508eafbd3be23c2084acd2f5cfc766922f9372b652dc416e"
  },
  "scope": "tunnel",
  "source": {
    "path": "protocol/bitwire-1/source/conformance/scenarios/tunnel/open-accept-and-speak-both-ways.json",
    "sha256": "a3f2a48bade0970dd80741759858881dd043affa3802dc1e666c9dbb3cd5a9d6"
  },
  "replaces": "tunnel/go/interop_test.go with tunnel/ts/src/interop.ts",
  "needs": [
    "peer",
    "tunnel"
  ],
  "steps": [
    {
      "on": "runner",
      "op": "pair.peers",
      "args": {
        "server": "a"
      },
      "bind": {
        "server": "pa",
        "client": "pb"
      }
    },
    {
      "on": "a",
      "op": "tunnel.over",
      "args": {
        "on": "$pa"
      },
      "bind": "ta"
    },
    {
      "on": "b",
      "op": "tunnel.over",
      "args": {
        "on": "$pb"
      },
      "bind": "tb"
    },
    {
      "on": "b",
      "op": "tunnel.open",
      "args": {
        "on": "$tb",
        "family": "probe"
      },
      "bind": {
        "handle": "cb",
        "id": "opened"
      },
      "expect": {
        "id": "$odd"
      },
      "note": "the client peer's tunnel mints odd ids"
    },
    {
      "on": "a",
      "op": "tunnel.accept",
      "args": {
        "on": "$ta"
      },
      "bind": {
        "handle": "ca"
      },
      "expect": {
        "id": "$opened",
        "family": "probe"
      }
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$ca",
        "role": "server"
      },
      "bind": "sa"
    },
    {
      "on": "b",
      "op": "peer.over",
      "args": {
        "on": "$cb",
        "role": "client"
      },
      "bind": "sb"
    },
    {
      "on": "a",
      "op": "peer.handle",
      "args": {
        "on": "$sa",
        "method": "echo",
        "behavior": {
          "kind": "echo"
        }
      }
    },
    {
      "on": "b",
      "op": "peer.call",
      "args": {
        "on": "$sb",
        "method": "echo",
        "params": {
          "over": "a channel"
        }
      },
      "bind": "c1"
    },
    {
      "on": "b",
      "op": "call.await",
      "args": {
        "on": "$c1"
      },
      "expect": {
        "result": {
          "over": "a channel"
        }
      }
    },
    {
      "on": "a",
      "op": "tunnel.open",
      "args": {
        "on": "$ta",
        "family": "codex"
      },
      "bind": {
        "handle": "ca2",
        "id": "opened2"
      },
      "expect": {
        "id": "$even"
      },
      "note": "the server peer's tunnel mints even ids"
    },
    {
      "on": "b",
      "op": "tunnel.accept",
      "args": {
        "on": "$tb"
      },
      "bind": {
        "handle": "cb2"
      },
      "expect": {
        "id": "$opened2",
        "family": "codex"
      }
    },
    {
      "on": "b",
      "op": "peer.over",
      "args": {
        "on": "$cb2",
        "role": "server"
      },
      "bind": "sb2"
    },
    {
      "on": "a",
      "op": "peer.over",
      "args": {
        "on": "$ca2",
        "role": "client"
      },
      "bind": "sa2"
    },
    {
      "on": "b",
      "op": "peer.handle",
      "args": {
        "on": "$sb2",
        "method": "multiply",
        "behavior": {
          "kind": "return",
          "value": {
            "value": 21
          }
        }
      }
    },
    {
      "on": "a",
      "op": "peer.call",
      "args": {
        "on": "$sa2",
        "method": "multiply",
        "params": {
          "value": 7
        }
      },
      "bind": "c2"
    },
    {
      "on": "a",
      "op": "call.await",
      "args": {
        "on": "$c2"
      },
      "expect": {
        "result": {
          "value": 21
        }
      }
    },
    {
      "on": "a",
      "op": "peer.emit",
      "args": {
        "on": "$sa",
        "event": "done",
        "data": {
          "ok": true
        }
      }
    },
    {
      "on": "b",
      "op": "peer.await_event",
      "args": {
        "on": "$sb",
        "name": "done"
      },
      "expect": {
        "data": {
          "ok": true
        }
      }
    }
  ]
}
