{
  "format": "bitwire-stream/1",
  "specification": "docs/wire/carriers.md#the-framed-byte-stream-bitwire-stream1",
  "status": "vectors for the adopted format, before its publication; no implementation claims them yet",
  "vectors": [
    {
      "id": "text-record",
      "why": "A text record delivers its body as one text frame.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 5\r\n\r\nhello"],
      "expect": { "frames": [{ "kind": "text", "body": ["hello"] }], "end": "open" }
    },
    {
      "id": "binary-record",
      "why": "A binary record delivers its body's exact bytes as one binary frame.",
      "limit": 1024, "eof": false,
      "input": ["Frame: binary\r\nContent-Length: 4\r\n\r\n", { "hex": "00ff0d0a" }],
      "expect": { "frames": [{ "kind": "binary", "body": [{ "hex": "00ff0d0a" }] }], "end": "open" }
    },
    {
      "id": "empty-text-record",
      "why": "A text record may have an empty body.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [{ "kind": "text", "body": [] }], "end": "open" }
    },
    {
      "id": "empty-binary-record",
      "why": "A binary record may have an empty body.",
      "limit": 1024, "eof": false,
      "input": ["Frame: binary\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [{ "kind": "binary", "body": [] }], "end": "open" }
    },
    {
      "id": "records-follow-without-delimiter",
      "why": "The next record begins at the byte after a body; several records may arrive in one read.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 2\r\n\r\nhiFrame: binary\r\nContent-Length: 1\r\n\r\n", { "hex": "07" }, "Frame: text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [{ "kind": "text", "body": ["hi"] }, { "kind": "binary", "body": [{ "hex": "07" }] }, { "kind": "text", "body": [] }], "end": "open" }
    },
    {
      "id": "body-bytes-are-not-headers",
      "why": "A body that spells a close record is data; the body is never searched for records.",
      "limit": 1024, "eof": false,
      "input": ["Frame: binary\r\nContent-Length: 47\r\n\r\nFrame: close\r\nCode: 1000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [{ "kind": "binary", "body": ["Frame: close\r\nCode: 1000\r\nContent-Length: 0\r\n\r\n"] }], "end": "open" }
    },
    {
      "id": "empty-lines-in-a-body",
      "why": "CR LF CR LF inside a body is body data.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 6\r\n\r\na\r\n\r\nb"],
      "expect": { "frames": [{ "kind": "text", "body": ["a\r\n\r\nb"] }], "end": "open" }
    },
    {
      "id": "text-body-is-not-validated",
      "why": "The framer neither decodes nor validates text; the protocol binding does.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 4\r\n\r\n", { "hex": "fffec0af" }],
      "expect": { "frames": [{ "kind": "text", "body": [{ "hex": "fffec0af" }] }], "end": "open" }
    },
    {
      "id": "body-at-the-limit",
      "why": "A body exactly at the receive limit is delivered.",
      "limit": 5, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 5\r\n\r\nhello"],
      "expect": { "frames": [{ "kind": "text", "body": ["hello"] }], "end": "open" }
    },
    {
      "id": "empty-body-at-a-zero-limit",
      "why": "An empty body is within a receive limit of zero.",
      "limit": 0, "eof": false,
      "input": ["Frame: binary\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [{ "kind": "binary", "body": [] }], "end": "open" }
    },
    {
      "id": "partial-header-waits",
      "why": "A valid prefix of a header block waits for more input.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Le"],
      "expect": { "frames": [], "end": "open" }
    },
    {
      "id": "partial-body-waits",
      "why": "Nothing of a record is delivered before its whole body has arrived.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 5\r\n\r\nhel"],
      "expect": { "frames": [], "end": "open" }
    },

    {
      "id": "end-of-input-at-the-start",
      "why": "End of input before any record, without a close record, is observed as 1006; no close record is sent.",
      "limit": 1024, "eof": true,
      "input": [],
      "expect": { "frames": [], "end": "eof" }
    },
    {
      "id": "end-of-input-between-records",
      "why": "Records before the end of input are delivered; the end without a close record is observed as 1006.",
      "limit": 1024, "eof": true,
      "input": ["Frame: text\r\nContent-Length: 2\r\n\r\nhi"],
      "expect": { "frames": [{ "kind": "text", "body": ["hi"] }], "end": "eof" }
    },
    {
      "id": "end-of-input-inside-a-header-block",
      "why": "End of input after a valid prefix of a header block is a truncation, not a grammar refusal.",
      "limit": 1024, "eof": true,
      "input": ["Frame: text\r\nContent-Length: 1"],
      "expect": { "frames": [], "end": "truncated" }
    },
    {
      "id": "end-of-input-after-a-header-block",
      "why": "End of input after a complete header block whose body has not begun is a truncation.",
      "limit": 1024, "eof": true,
      "input": ["Frame: text\r\nContent-Length: 3\r\n\r\n"],
      "expect": { "frames": [], "end": "truncated" }
    },
    {
      "id": "end-of-input-inside-a-body",
      "why": "Nothing of a partial record is delivered; earlier records are.",
      "limit": 1024, "eof": true,
      "input": ["Frame: text\r\nContent-Length: 1\r\n\r\naFrame: text\r\nContent-Length: 5\r\n\r\nhel"],
      "expect": { "frames": [{ "kind": "text", "body": ["a"] }], "end": "truncated" }
    },
    {
      "id": "end-of-input-inside-a-close-header",
      "why": "A partial close record is a truncation too.",
      "limit": 1024, "eof": true,
      "input": ["Frame: close\r\nCode: 10"],
      "expect": { "frames": [], "end": "truncated" }
    },
    {
      "id": "end-of-input-inside-a-close-code",
      "why": "A close code is syntax until its header block matches, so a partial code at the end of input is a truncation.",
      "limit": 1024, "eof": true,
      "input": ["Frame: close\r\nCode: 2"],
      "expect": { "frames": [], "end": "truncated" }
    },
    {
      "id": "end-of-input-after-an-invalid-close-code",
      "why": "A close code is checked against the valid set only once its header block matches.",
      "limit": 1024, "eof": true,
      "input": ["Frame: close\r\nCode: 1004\r\n"],
      "expect": { "frames": [], "end": "truncated" }
    },
    {
      "id": "end-of-input-inside-a-close-reason",
      "why": "A close reason is checked only once its body is complete, so a partial one is a truncation whatever its bytes.",
      "limit": 1024, "eof": true,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 4\r\n\r\n", { "hex": "ff" }],
      "expect": { "frames": [], "end": "truncated" }
    },
    {
      "id": "end-of-input-after-a-grammar-error",
      "why": "Bytes that cannot begin a valid header block are refused, even when input ends before the block would.",
      "limit": 1024, "eof": true,
      "input": ["Frame: TEXT"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "end-of-input-after-an-over-limit-header",
      "why": "An over-limit header block is refused with 1009 even when input ends before its body.",
      "limit": 4, "eof": true,
      "input": ["Frame: binary\r\nContent-Length: 5\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1009 }, "end": "refused" }
    },
    {
      "id": "end-of-input-after-an-over-long-close-header",
      "why": "A close header block declaring more than 123 bytes is refused with 1002 even when input ends before its body.",
      "limit": 1048576, "eof": true,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 124\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },

    {
      "id": "close-record",
      "why": "A close record ends the input; the reply echoes its code with an empty reason.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 4\r\n\r\ndone"],
      "expect": { "frames": [], "peerClose": { "code": 1000, "reason": ["done"] }, "send": { "code": 1000 }, "end": "closed" }
    },
    {
      "id": "close-record-with-an-empty-reason",
      "why": "A close reason may be empty.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1001\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "peerClose": { "code": 1001, "reason": [] }, "send": { "code": 1001 }, "end": "closed" }
    },
    {
      "id": "close-code-1003",
      "why": "1003 is the top of the first valid range.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1003\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "peerClose": { "code": 1003, "reason": [] }, "send": { "code": 1003 }, "end": "closed" }
    },
    {
      "id": "close-code-1007",
      "why": "1007 is the bottom of the second valid range.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1007\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "peerClose": { "code": 1007, "reason": [] }, "send": { "code": 1007 }, "end": "closed" }
    },
    {
      "id": "close-code-1014",
      "why": "1014 is the top of the second valid range.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1014\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "peerClose": { "code": 1014, "reason": [] }, "send": { "code": 1014 }, "end": "closed" }
    },
    {
      "id": "close-code-3000",
      "why": "3000 is the bottom of the third valid range.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 3000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "peerClose": { "code": 3000, "reason": [] }, "send": { "code": 3000 }, "end": "closed" }
    },
    {
      "id": "close-code-4999",
      "why": "4999, private use, is the top of the third valid range.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 4999\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "peerClose": { "code": 4999, "reason": [] }, "send": { "code": 4999 }, "end": "closed" }
    },
    {
      "id": "close-reason-in-utf-8",
      "why": "A close reason is UTF-8 and is delivered as sent.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 2\r\n\r\n", { "hex": "c3a9" }],
      "expect": { "frames": [], "peerClose": { "code": 1000, "reason": [{ "hex": "c3a9" }] }, "send": { "code": 1000 }, "end": "closed" }
    },
    {
      "id": "close-reason-of-123-bytes-at-a-zero-limit",
      "why": "A close reason has its own 123-byte limit, separate from the data limit.",
      "limit": 0, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 123\r\n\r\n", { "fill": "a", "count": 123 }],
      "expect": { "frames": [], "peerClose": { "code": 1000, "reason": [{ "fill": "a", "count": 123 }] }, "send": { "code": 1000 }, "end": "closed" }
    },
    {
      "id": "records-before-a-close-are-delivered",
      "why": "Records before a close record are delivered in order.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 2\r\n\r\nhiFrame: close\r\nCode: 1000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [{ "kind": "text", "body": ["hi"] }], "peerClose": { "code": 1000, "reason": [] }, "send": { "code": 1000 }, "end": "closed" }
    },
    {
      "id": "no-data-after-a-close",
      "why": "After the first valid close record, no further data is delivered.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 0\r\n\r\nFrame: text\r\nContent-Length: 2\r\n\r\nhi"],
      "expect": { "frames": [], "peerClose": { "code": 1000, "reason": [] }, "send": { "code": 1000 }, "end": "closed" }
    },
    {
      "id": "trailing-bytes-after-a-close",
      "why": "Trailing bytes after a close record are discarded and do not replace the recorded ending.",
      "limit": 1024, "eof": true,
      "input": ["Frame: close\r\nCode: 1001\r\nContent-Length: 0\r\n\r\ngarbage", { "hex": "ff00" }],
      "expect": { "frames": [], "peerClose": { "code": 1001, "reason": [] }, "send": { "code": 1001 }, "end": "closed" }
    },
    {
      "id": "a-second-close-is-not-answered",
      "why": "A second close record neither changes the recorded close nor draws a second reply.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 0\r\n\r\nFrame: close\r\nCode: 3000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "peerClose": { "code": 1000, "reason": [] }, "send": { "code": 1000 }, "end": "closed" }
    },

    {
      "id": "close-code-1004-is-refused",
      "why": "1004 is reserved and outside the valid set.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1004\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-1005-is-refused",
      "why": "1005 is observe-only and never sent.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1005\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-1006-is-refused",
      "why": "1006 is observe-only and never sent.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1006\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-1015-is-refused",
      "why": "1015 is observe-only and never sent.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1015\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-1016-is-refused",
      "why": "The valid set is frozen; a later registry assignment does not add 1016.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1016\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-2999-is-refused",
      "why": "2999 lies between the valid ranges.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 2999\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-5000-is-refused",
      "why": "5000 is above the valid set.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 5000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-0999-is-refused",
      "why": "Four digits alone do not make a valid code.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 0999\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-of-three-digits-is-refused",
      "why": "A code is exactly four digits.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 999\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-of-five-digits-is-refused",
      "why": "A code is exactly four digits.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 10000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-code-with-a-letter-is-refused",
      "why": "A code is decimal digits alone.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 10a0\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "lowercase-code-header-is-refused",
      "why": "Header names are case-sensitive.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\ncode: 1000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "reordered-close-headers-are-refused",
      "why": "Code comes before Content-Length.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nContent-Length: 0\r\nCode: 1000\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "repeated-code-header-is-refused",
      "why": "Each header appears once.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nCode: 1000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-without-a-code-is-refused",
      "why": "A close record carries a Code header.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "text-with-a-code-is-refused",
      "why": "Only a close record carries a Code header.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nCode: 1000\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-reason-of-124-bytes-is-refused-from-its-header",
      "why": "A close record declaring more than 123 bytes is refused from its header alone.",
      "limit": 1048576, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 124\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-reason-not-utf-8-is-refused",
      "why": "A close reason is the framer's own control data and must be valid UTF-8.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 1\r\n\r\n", { "hex": "ff" }],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-reason-overlong-utf-8-is-refused",
      "why": "An overlong encoding is not valid UTF-8.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 2\r\n\r\n", { "hex": "c0af" }],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-reason-surrogate-is-refused",
      "why": "An encoded surrogate is not valid UTF-8.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 3\r\n\r\n", { "hex": "eda080" }],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "close-reason-ending-mid-character-is-refused",
      "why": "A complete close body that ends inside a character is not valid UTF-8.",
      "limit": 1024, "eof": false,
      "input": ["Frame: close\r\nCode: 1000\r\nContent-Length: 2\r\n\r\n", { "hex": "e282" }],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },

    {
      "id": "lowercase-header-name-is-refused",
      "why": "Header names are case-sensitive.",
      "limit": 1024, "eof": false,
      "input": ["frame: text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "lowercase-content-length-is-refused",
      "why": "Header names are case-sensitive.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\ncontent-length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "capitalized-kind-is-refused",
      "why": "Frame kinds are case-sensitive.",
      "limit": 1024, "eof": false,
      "input": ["Frame: Text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "unknown-kind-is-refused",
      "why": "There are three frame kinds.",
      "limit": 1024, "eof": false,
      "input": ["Frame: ping\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "tab-after-a-colon-is-refused",
      "why": "The separator is exactly one space.",
      "limit": 1024, "eof": false,
      "input": ["Frame:\ttext\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "missing-space-is-refused",
      "why": "The separator is exactly one space.",
      "limit": 1024, "eof": false,
      "input": ["Frame:text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "extra-space-is-refused",
      "why": "The separator is exactly one space.",
      "limit": 1024, "eof": false,
      "input": ["Frame:  text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "space-before-a-colon-is-refused",
      "why": "A header name is followed directly by its colon.",
      "limit": 1024, "eof": false,
      "input": ["Frame : text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "leading-space-is-refused",
      "why": "A header line begins with its name.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\n Content-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "non-ascii-header-byte-is-refused",
      "why": "A header block is ASCII.",
      "limit": 1024, "eof": false,
      "input": ["Frame: te", { "hex": "d8" }, "t\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "trailing-space-is-refused",
      "why": "Nothing follows a value but CR LF.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 0 \r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "bare-lf-is-refused",
      "why": "Lines end with CR LF; there is no recovery mode.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "lf-only-header-block-is-refused",
      "why": "A header block written with LF alone never matches, and is refused when input ends.",
      "limit": 1024, "eof": true,
      "input": ["Frame: text\nContent-Length: 0\n\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "bare-cr-is-refused",
      "why": "Lines end with CR LF.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\rContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "reordered-headers-are-refused",
      "why": "Frame comes first.",
      "limit": 1024, "eof": false,
      "input": ["Content-Length: 0\r\nFrame: text\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "repeated-frame-header-is-refused",
      "why": "Each header appears once.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nFrame: text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "repeated-content-length-is-refused",
      "why": "Each header appears once.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "additional-header-is-refused",
      "why": "There are no other headers.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 0\r\nX-Trace: 1\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "leading-zero-length-is-refused",
      "why": "A length has no leading zero.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 01\r\n\r\na"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "signed-length-is-refused",
      "why": "A length is decimal digits alone.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: +1\r\n\r\na"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "empty-length-is-refused",
      "why": "A length has at least one digit.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: \r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "sixteen-digit-length-is-refused",
      "why": "A length has at most 15 digits.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 1000000000000000\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "byte-order-mark-is-refused",
      "why": "Nothing precedes the first record, not even a byte order mark.",
      "limit": 1024, "eof": false,
      "input": [{ "hex": "efbbbf" }, "Frame: text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "banner-is-refused",
      "why": "A child that prints a banner to stdout is refused.",
      "limit": 1024, "eof": false,
      "input": ["listening on stdio\nFrame: text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "empty-line-before-a-record-is-refused",
      "why": "There is no delimiter between records.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 1\r\n\r\na\r\nFrame: text\r\nContent-Length: 0\r\n\r\n"],
      "expect": { "frames": [{ "kind": "text", "body": ["a"] }], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "header-block-at-the-cap-is-refused",
      "why": "A receiver that has read 128 bytes without completing a header block refuses it.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: ", { "fill": "1", "count": 99 }],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    },
    {
      "id": "records-before-a-refusal-are-delivered",
      "why": "A refusal ends the input after the records already complete.",
      "limit": 1024, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 1\r\n\r\naFrame: text \r\nContent-Length: 0\r\n\r\nFrame: text\r\nContent-Length: 1\r\n\r\nb"],
      "expect": { "frames": [{ "kind": "text", "body": ["a"] }], "send": { "code": 1002 }, "end": "refused" }
    },

    {
      "id": "over-limit-from-the-header-alone",
      "why": "An over-limit record is refused with 1009 from its complete header block, without waiting for any body byte.",
      "limit": 4, "eof": false,
      "input": ["Frame: binary\r\nContent-Length: 5\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1009 }, "end": "refused" }
    },
    {
      "id": "over-limit-with-its-body",
      "why": "The refused body and what follows it are not delivered.",
      "limit": 4, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 5\r\n\r\nhelloFrame: text\r\nContent-Length: 1\r\n\r\na"],
      "expect": { "frames": [], "send": { "code": 1009 }, "end": "refused" }
    },
    {
      "id": "over-a-zero-limit",
      "why": "One byte exceeds a receive limit of zero.",
      "limit": 0, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 1\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1009 }, "end": "refused" }
    },
    {
      "id": "over-limit-after-records",
      "why": "Records before an over-limit record are delivered.",
      "limit": 4, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 4\r\n\r\nfourFrame: text\r\nContent-Length: 5\r\n\r\n"],
      "expect": { "frames": [{ "kind": "text", "body": ["four"] }], "send": { "code": 1009 }, "end": "refused" }
    },
    {
      "id": "fifteen-digit-length-over-the-limit",
      "why": "The largest length the grammar allows is compared with the limit, not refused as syntax.",
      "limit": 1024, "eof": false,
      "input": ["Frame: binary\r\nContent-Length: 999999999999999\r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1009 }, "end": "refused" }
    },
    {
      "id": "length-beyond-32-bits",
      "why": "A length is compared with the limit before it is narrowed; 2^32 + 1 does not wrap to 1.",
      "limit": 1048576, "eof": false,
      "input": ["Frame: binary\r\nContent-Length: 4294967297\r\n\r\n", { "hex": "00" }],
      "expect": { "frames": [], "send": { "code": 1009 }, "end": "refused" }
    },
    {
      "id": "grammar-error-outranks-over-limit",
      "why": "The header block is validated whole before its length is compared with the limit.",
      "limit": 4, "eof": false,
      "input": ["Frame: text\r\nContent-Length: 99 \r\n\r\n"],
      "expect": { "frames": [], "send": { "code": 1002 }, "end": "refused" }
    }
  ]
}
